{
  "name": "supervisor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "build:ui": "vite build",
    "check": "tsc --noEmit && vite build",
    "dev:ui": "vite --host 127.0.0.1",
