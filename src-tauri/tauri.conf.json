{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Supervisor",
  "version": "0.1.0",
  "identifier": "app.supervisor.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:ui",
    "beforeBuildCommand": "npm run build:ui",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Supervisor",
        "width": 920,
        "height": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}

